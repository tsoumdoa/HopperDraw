<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ShouldRemoveRhinoReferences>false</ShouldRemoveRhinoReferences>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Enums/*.cs" Link="Enums/%(Filename)%(Extension)" />
    <Compile Include="../../HopperDraw.Session.cs" Link="HopperDraw.Session.cs" />
    <Compile Include="../../HopperDraw.cs" Link="HopperDraw.cs" />
    <Compile Include="../../HopperDrawUIAttributes.cs" Link="HopperDrawUIAttributes.cs" />
    <Compile Include="../../Shapes/*.cs" Link="Shapes/%(Filename)%(Extension)" />
    <Compile Include="../../Utilities/*.cs" Exclude="../../Utilities/FreehandStroke.cs;../../Utilities/HatchRenderer.cs" Link="Utilities/%(Filename)%(Extension)" />
    <Compile Include="../../Utilities/FreehandStroke.cs" Link="Utilities/FreehandStroke.cs" />
    <Compile Include="../../Utilities/HatchRenderer.cs" Link="Utilities/HatchRenderer.cs" />
    <PackageReference Include="Grasshopper" Version="8.0.23304.9001" />
  </ItemGroup>
</Project>
